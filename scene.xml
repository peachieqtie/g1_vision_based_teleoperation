<mujoco model="g1_29dof_rev_1_0 scene">
  <include file="g1.xml"/>

  <statistic center="1.2 0 0.8" extent="1.2"/>

  <option timestep="0.002" gravity="0 0 -9.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality offsamples="4"/>
    <global azimuth="0" elevation="-15" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="platform_pickup" pos="1.5 0 0.73">
      <!-- Q6: enlarged for box-position randomisation. x half-extent is 0.19, NOT larger:
           the pelvis cannot pass under the 0.75 m top, so the base stops at x=1.255 and
           GRASP_MAX caps reachable box x at 1.595. Growing half_x moves the far sample
           edge out of reach without buying span. y has no such cap. See CLAUDE.md O13. -->
      <geom name="platform_pickup_geom" type="box" size="0.19 0.32 0.02" rgba="0.55 0.2 0.75 1"/>
    </body>

    <body name="platform_goal" pos="1.5 -1.5 0.73">
      <geom name="platform_goal_geom" type="box" size="0.18 0.18 0.02" rgba="0.55 0.2 0.75 1"/>
    </body>

    <body name="goal_marker" pos="1.5 -1.5 0.751">
      <geom name="goal_marker_geom" type="cylinder" size="0.06 0.001" rgba="0.1 0.9 0.1 0.6" contype="0" conaffinity="0"/>
    </body>

    <body name="box1" pos="1.5 0 0.84">
      <freejoint name="box1_joint"/>
      <inertial pos="0 0 0" mass="0.4" diaginertia="0.00216 0.00216 0.00216"/>
      <geom name="box1_geom" type="box" size="0.09 0.09 0.09" rgba="1 0 0 1" friction="1.5 0.05 0.001" solref="0.004 1" solimp="0.9 0.95 0.001"/>
    </body>
  </worldbody>

  <!-- Grasp weld (D11). Friction grasping was characterised as infeasible under
       our constraints: 1 of 9 standoffs holds, and holding couples to unrelated
       foot-floor contacts. See CLAUDE.md O2 / section 7 D11 and NOTES.md.
       Attaches the box to the LEFT hand only - two welds would over-constrain,
       and the hand (not the pad) is chosen because the pad slides on its joint.
       relpose is written at engage time from the live relative transform, so
       engagement produces no jump. Inactive until the trigger fires. -->
  <equality>
    <weld name="box_grasp" body1="left_wrist_yaw_link" body2="box1"
          active="false" solref="0.004 1" solimp="0.95 0.99 0.001"/>

    <!-- Base support during manipulation (D12). O17/TR16: the standing robot's
         equilibrium standoff never coincides with the standoff its arms can
         serve, and every free-base lever is swept and closed. This weld pins
         the pelvis to the world while the arms work, and is released for
         locomotion. relpose is written live at lock time (g1_teleop/base_lock.py)
         so the constraint is already satisfied when it turns on and the base
         does not jump. Stiffer than the grasp weld: this one carries the whole
         robot's reaction, and any compliance here shows up directly as standoff
         drift, which is the thing it exists to remove. Inactive by default. -->
    <weld name="base_lock" body1="world" body2="pelvis"
          active="false" solref="0.002 1" solimp="0.99 0.999 0.001"/>
  </equality>
</mujoco>
